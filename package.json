{
  "name": "ai-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "automation": "node --experimental-strip-types automation/run.ts",
    "deploy:admin": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.4",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1",
    "fast-xml-parser": "^5.5.7",
    "pagefind": "^1.4.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
