---
import { ARTICLE_CATEGORIES } from '../../lib/article-schema';
const categories = ARTICLE_CATEGORIES;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>AI Pulse · Owner dashboard</title>
    <style is:global>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172126;background:#f5f7f6;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{min-height:100vh;display:grid;grid-template-columns:244px 1fr}.side{background:#102a27;color:#eff8f4;padding:25px 16px;display:flex;flex-direction:column;gap:26px}.brand{font-size:20px;font-weight:760;letter-spacing:-.6px;padding:0 12px}.brand span{color:#6fe0b1}.owner{margin:0 12px;padding:14px;border:1px solid #ffffff21;border-radius:12px;color:#bdd0ca;font-size:12px}.owner strong{display:block;color:#fff;font-size:13px;margin-bottom:4px}.nav{display:grid;gap:5px}.nav button{display:flex;gap:11px;align-items:center;text-align:left;background:transparent;color:#c9d9d4;border:0;border-radius:9px;padding:11px 13px;font-size:14px}.nav button:hover,.nav button.active{background:#ffffff15;color:#fff}.nav .ico{width:18px;text-align:center;font-size:15px}.side-foot{margin-top:auto;padding:0 12px;color:#9fb7af;font-size:12px}.main{min-width:0;padding:34px clamp(18px,4vw,54px) 60px;max-width:1500px;width:100%;margin:0 auto}.top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:28px}.eyebrow{text-transform:uppercase;letter-spacing:1.4px;color:#618079;font-size:11px;font-weight:700}.top h1{font-size:30px;letter-spacing:-.8px;margin:5px 0 7px}.sub{color:#697773;margin:0;font-size:14px}.top-actions{display:flex;gap:9px}.button{background:#126950;color:#fff;border:0;border-radius:9px;padding:10px 14px;font-weight:650;font-size:13px;box-shadow:0 2px 5px #102a2716}.button:hover{background:#0e5843}.button.secondary{background:#fff;color:#29413a;border:1px solid #dce5e1;box-shadow:none}.button.danger{background:#a13d38}.button.small{padding:7px 10px;font-size:12px}.button:disabled{opacity:.55;cursor:wait}.grid{display:grid;gap:16px}.metrics{grid-template-columns:repeat(5,minmax(0,1fr));margin-bottom:18px}.panel,.metric{background:#fff;border:1px solid #e5ebe8;border-radius:13px;box-shadow:0 4px 16px #183c3010}.metric{padding:18px}.metric label{display:block;color:#74817d;font-size:12px}.metric strong{display:block;font-size:28px;margin-top:7px;letter-spacing:-.8px}.panel{padding:21px;margin-bottom:17px}.panel h2{font-size:17px;margin:0 0 14px;letter-spacing:-.25px}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:12px}.panel-head h2{margin:0}.split{grid-template-columns:1.25fr 1fr}.runrow,.activity,.feedrow{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 0;border-top:1px solid #edf1ef}.runrow:first-of-type,.activity:first-of-type,.feedrow:first-of-type{border-top:0}.muted{color:#71807b;font-size:13px}.pill{display:inline-flex;align-items:center;border-radius:999px;padding:5px 9px;background:#edf5f1;color:#32664e;font-size:11px;font-weight:700;white-space:nowrap}.pill.red{background:#faedeb;color:#9c403c}.pill.amber{background:#fff5df;color:#8a681f}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;min-width:850px}th{text-align:left;color:#71807b;font-size:11px;text-transform:uppercase;letter-spacing:.7px;padding:11px;border-bottom:1px solid #e9efec}td{padding:13px 11px;border-bottom:1px solid #edf1ef;font-size:13px;vertical-align:middle}td.title{font-weight:650;max-width:330px}.actions{display:flex;gap:6px;flex-wrap:wrap}.filters{display:flex;gap:9px;flex-wrap:wrap;margin:15px 0}.field,select,textarea{background:#fff;color:#1d2c27;border:1px solid #d9e3df;border-radius:8px;padding:10px 11px;min-width:135px}.field.search{flex:1;min-width:220px}.field:focus,select:focus,textarea:focus{outline:3px solid #c4ebd9;border-color:#69b996}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.form-field{display:grid;gap:6px}.form-field label{font-size:12px;font-weight:650;color:#53655e}.form-field small{color:#78857f;font-size:11px}.form-field.full{grid-column:1/-1}.form-field textarea{min-height:100px;resize:vertical}.checkline{display:flex;align-items:flex-start;gap:10px;padding:10px 0;font-size:13px}.checkline input{margin-top:3px;accent-color:#126950}.checkcats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.empty{padding:35px 15px;text-align:center;color:#72807a}.empty strong{color:#344740;display:block;margin-bottom:5px}.notice{position:fixed;right:22px;bottom:22px;padding:13px 16px;color:#fff;background:#173c32;border-radius:10px;box-shadow:0 8px 28px #102a2733;z-index:10;max-width:min(420px,calc(100vw - 44px));font-size:13px}.notice.error{background:#963c37}.notice[hidden]{display:none}dialog{border:0;border-radius:14px;width:min(900px,calc(100vw - 26px));max-height:90vh;padding:0;box-shadow:0 18px 70px #081c1780}dialog::backdrop{background:#0a211ccc}.modal-head,.modal-foot{padding:17px 21px;border-bottom:1px solid #e8eeeb;display:flex;justify-content:space-between;align-items:center;gap:12px}.modal-foot{border-bottom:0;border-top:1px solid #e8eeeb;justify-content:flex-end}.modal-body{padding:20px;overflow:auto;max-height:calc(90vh - 125px)}.modal-head h2{margin:0;font-size:18px}.close{background:none;border:0;font-size:22px;color:#60716a}.markdown{font-family:ui-monospace,SFMono-Regular,monospace;min-height:310px;width:100%;line-height:1.6}.statusline{display:flex;align-items:center;gap:8px}.link{color:#126950;text-decoration:none;font-weight:650}.link:hover{text-decoration:underline}.source-grid{grid-template-columns:1fr 1fr}.bar{height:1px;background:#e7eeea;margin:17px 0}.loading{color:#75827d;font-size:13px;padding:28px;text-align:center}.mobile-brand{display:none}
      @media(max-width:1050px){.metrics{grid-template-columns:repeat(3,1fr)}.split{grid-template-columns:1fr}}
      @media(max-width:700px){.shell{display:block}.side{padding:13px 14px;position:sticky;top:0;z-index:3;gap:12px}.brand{padding:4px 5px}.owner,.side-foot{display:none}.nav{display:flex;overflow:auto;gap:4px}.nav button{white-space:nowrap;padding:9px 11px;font-size:12px}.nav .ico{display:none}.main{padding:23px 14px 45px}.top{margin-bottom:20px;display:block}.top h1{font-size:26px}.top-actions{margin-top:14px}.metrics{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.metric{padding:14px}.metric strong{font-size:24px}.panel{padding:16px}.form-grid,.source-grid{grid-template-columns:1fr}.form-field.full{grid-column:auto}.checkcats{grid-template-columns:repeat(2,1fr)}.panel-head{align-items:flex-start;flex-direction:column}.top-actions .button{flex:1}.filters>*{flex:1}.field.search{flex-basis:100%}}
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <a class="brand" href="/" aria-label="AI Pulse homepage">AI <span>Pulse</span></a>
        <div class="owner" id="owner"><strong>Private workspace</strong>Verifying Cloudflare Access…</div>
        <nav class="nav" aria-label="Admin navigation">
          <button data-page="overview" class="active"><span class="ico">◫</span>Overview</button>
          <button data-page="articles"><span class="ico">▤</span>Articles</button>
          <button data-page="automation"><span class="ico">↻</span>Automation</button>
          <button data-page="sources"><span class="ico">◉</span>News Sources</button>
          <button data-page="ai-settings"><span class="ico">✳</span>AI Settings</button>
          <button data-page="logs"><span class="ico">≡</span>Logs</button>
          <button data-page="settings"><span class="ico">⚙</span>Settings</button>
        </nav>
        <div class="side-foot">Private owner dashboard · AI Pulse</div>
      </aside>
      <main class="main">
        <header class="top"><div><div class="eyebrow">AI Pulse · Control room</div><h1 id="page-title">Overview</h1><p class="sub" id="page-sub">A clear view of publication health and recent activity.</p></div><div class="top-actions"><button id="refresh" class="button secondary">↻ &nbsp;Refresh</button><button id="run-shortcut" class="button">Run automation</button></div></header>
        <div id="view"><div class="loading">Loading secure dashboard data…</div></div>
      </main>
    </div>
    <div class="notice" id="notice" role="status" aria-live="polite" hidden></div>
    <dialog id="editor"><div class="modal-head"><h2 id="editor-title">Edit article</h2><button class="close" data-close aria-label="Close">×</button></div><div class="modal-body" id="editor-body"></div><div class="modal-foot"><button class="button secondary" data-close>Cancel</button><button class="button" id="save-article">Save changes</button></div></dialog>
    <dialog id="source-modal"><div class="modal-head"><h2 id="source-title">Add news source</h2><button class="close" data-close aria-label="Close">×</button></div><div class="modal-body"><div class="form-grid"><div class="form-field"><label for="source-name">Name</label><input class="field" id="source-name" maxlength="100" required /></div><div class="form-field"><label for="source-url">Feed URL</label><input class="field" id="source-url" type="url" placeholder="https://example.com/feed.xml" required /></div><div class="form-field"><label for="source-category">Category</label><select id="source-category">{categories.map((category) => <option>{category}</option>)}</select></div><div class="form-field"><label for="source-reliability">Reliability</label><select id="source-reliability"><option value="primary">Primary source</option><option value="peer-reviewed">Peer reviewed</option><option value="reputable-secondary">Reputable secondary</option><option value="other">Other</option></select></div><label class="checkline"><input type="checkbox" id="source-enabled" checked /> Enabled for discovery</label></div><div id="feed-validation" class="muted"></div></div><div class="modal-foot"><button class="button secondary" data-close>Cancel</button><button class="button secondary" id="validate-feed">Validate feed</button><button class="button" id="save-source">Save source</button></div></dialog>
    <dialog id="confirm-modal"><div class="modal-head"><h2 id="confirm-title">Please confirm</h2><button class="close" data-close aria-label="Close">×</button></div><div class="modal-body" id="confirm-body"></div><div class="modal-foot"><button class="button secondary" data-close>Cancel</button><button class="button danger" id="confirm-action">Confirm</button></div></dialog>
    <script define:vars={{ categoriesFromServer: categories }}>
      const API = '/admin-api/admin';
      const categories = categoriesFromServer;
      const titleMap = {overview:['Overview','A clear view of publication health and recent activity.'],articles:['Articles','Review, edit, and manage the publication queue.'],automation:['Automation','Monitor scheduled runs and start a run when needed.'],sources:['News Sources','Control trusted feeds used for story discovery.'], 'ai-settings':['AI Settings','Adjust generation thresholds while core safeguards stay enabled.'],logs:['Logs','Recent workflow runs and source health.'],settings:['Settings','Account, repository, and secure access details.']};
      const $ = (selector, root=document) => root.querySelector(selector);
      const view = $('#view'), notice = $('#notice');
      let articles=[], sources=[], settings=null, currentEditorSlug=null, currentSourceName=null, pendingConfirm=null, activePage='overview', automationTimer=null;
      const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
      const date = value => value ? new Intl.DateTimeFormat(undefined,{dateStyle:'medium',timeStyle:'short'}).format(new Date(value)) : '—';
      function toast(message,error=false){notice.textContent=message;notice.classList.toggle('error',error);notice.hidden=false;clearTimeout(toast.timer);toast.timer=setTimeout(()=>notice.hidden=true,4500)}
      async function api(path, options={}){const response=await fetch(`${API}${path}`,{...options,credentials:'include',headers:{...(options.body?{'content-type':'application/json'}:{}),...options.headers}});const data=await response.json().catch(()=>({error:`Server returned HTTP ${response.status}`}));if(!response.ok)throw new Error(data.error||`Request failed (${response.status})`);return data}
      const post=(path,payload)=>api(path,{method:'POST',body:JSON.stringify(payload)});
      const put=(path,payload)=>api(path,{method:'PUT',body:JSON.stringify(payload)});
      function pageHeader(){const [title,sub]=titleMap[activePage];$('#page-title').textContent=title;$('#page-sub').textContent=sub;document.querySelectorAll('[data-page]').forEach(button=>button.classList.toggle('active',button.dataset.page===activePage));}
      function empty(title,copy){return `<div class="empty"><strong>${esc(title)}</strong>${esc(copy)}</div>`}
      function metric(label,value){return `<div class="metric"><label>${esc(label)}</label><strong>${Number(value)||0}</strong></div>`}
      function badge(value){const name=String(value||'Unknown');const cls=['REJECTED','failed','failure'].includes(name.toLowerCase())||name==='REJECTED'?'red':['PENDING','in_progress','queued','HIGH'].includes(name)?'amber':'';return `<span class="pill ${cls}">${esc(name.replaceAll('_',' '))}</span>`}
      async function overview(){const data=await api('/overview');$('#owner').innerHTML=`<strong>Signed in as owner</strong>${esc(data.adminEmail)}`;const c=data.counts;const run=data.latestRun;const activity=data.recentActivity||[];return `<div class="grid metrics">${metric('Published articles',c.published)}${metric('Pending review',c.pending)}${metric('Rejected',c.rejected)}${metric('Published today',c.today)}${metric('Published this week',c.thisWeek)}</div><div class="grid split"><section class="panel"><div class="panel-head"><h2>Automation health</h2>${badge(run?.conclusion||run?.status||'No runs yet')}</div>${run?`<div class="runrow"><div><strong>${esc(run.name)}</strong><div class="muted">Last run · ${date(run.createdAt)}</div></div><a class="link" href="${esc(run.url)}" target="_blank" rel="noreferrer">Open run ↗</a></div>`:empty('No runs recorded','The first workflow run will appear here.') }<div class="runrow"><div><strong>Next scheduled run</strong><div class="muted">GitHub Actions schedule · daily at 10:17 UTC</div></div><span>${date(data.nextScheduledRun)}</span></div>${data.runSummary?`<div class="runrow"><div><strong>Latest pipeline result</strong><div class="muted">${Number(data.runSummary.storiesDiscovered)||0} stories found · ${Number(data.runSummary.articlesPublished)||0} published</div></div>${badge(data.runSummary.status)}</div>`:''}</section><section class="panel"><h2>Recent activity</h2>${activity.length?activity.map(item=>`<div class="activity"><div><strong>${esc(item.message)}</strong><div class="muted">${esc(item.author)} · ${date(item.at)}</div></div><a class="link" href="${esc(item.url)}" target="_blank" rel="noreferrer">View ↗</a></div>`).join(''):empty('No article activity yet','GitHub article commits will be listed here.')}</section></div><section class="panel"><div class="panel-head"><h2>News source health</h2><button class="button secondary small" data-go="sources">Manage sources</button></div>${(data.sourceStatuses||[]).length?data.sourceStatuses.map(source=>`<div class="feedrow"><div><strong>${esc(source.name)}</strong><div class="muted">${Number(source.storiesFound)||0} stories · last success ${date(source.lastSuccessfulFetch)}</div>${source.errorInformation?`<div class="muted">${esc(source.errorInformation)}</div>`:''}</div>${badge(source.errorInformation?'Error':source.enabled?'Healthy':'Disabled')}</div>`).join(''):empty('No run health data','Source fetch details will show after a scheduled run.')}</section>`}
      function articleTable(rows){if(!rows.length)return empty('No matching articles','Try changing the filters, or wait for the next research run.');return `<div class="table-wrap"><table><thead><tr><th>Title</th><th>Category</th><th>Importance</th><th>Freshness</th><th>Publication date</th><th>Status</th><th>Actions</th></tr></thead><tbody>${rows.map(a=>`<tr><td class="title">${esc(a.title)}</td><td>${esc(a.category)}</td><td>${badge(`${a.importanceLevel} · ${a.importanceScore}/5`)}</td><td>${badge(a.freshness)}</td><td>${date(a.publishedAt)}</td><td>${badge(a.status)}</td><td><div class="actions"><button class="button secondary small" data-view="${esc(a.slug)}">View</button>${a.status==='PUBLISHED'?`<button class="button secondary small" data-edit="${esc(a.slug)}">Edit</button>`:`<button class="button secondary small" data-edit="${esc(a.slug)}">Edit</button>`}${a.status==='PENDING'?`<button class="button small" data-approve="${esc(a.slug)}">Approve</button><button class="button secondary small" data-reject="${esc(a.slug)}">Reject</button>`:''}<button class="button secondary small" data-delete="${esc(a.slug)}">Delete</button></div></td></tr>`).join('')}</tbody></table></div>`}
      async function articlePage(){articles=await api('/articles');return `<section class="panel"><div class="panel-head"><h2>Publication library</h2><span class="muted">${articles.length} articles</span></div><div class="filters"><input class="field search" id="article-search" placeholder="Search titles and introductions" aria-label="Search articles"><select id="filter-status"><option value="">All statuses</option><option>PUBLISHED</option><option>PENDING</option><option>REJECTED</option></select><select id="filter-category"><option value="">All categories</option>${categories.map(c=>`<option>${esc(c)}</option>`).join('')}</select><select id="filter-importance"><option value="">All importance</option>${['CRITICAL','HIGH','MEDIUM','LOW'].map(x=>`<option>${x}</option>`).join('')}</select><input id="filter-date" class="field" type="date" aria-label="Published on or after"></div><div id="article-table">${articleTable(articles)}</div></section>`}
      function renderArticleFilters(){const query=$('#article-search')?.value.toLowerCase()||'',status=$('#filter-status')?.value||'',category=$('#filter-category')?.value||'',importance=$('#filter-importance')?.value||'',from=$('#filter-date')?.value;const filtered=articles.filter(a=>(!query||`${a.title} ${a.introduction}`.toLowerCase().includes(query))&&(!status||a.status===status)&&(!category||a.category===category)&&(!importance||a.importanceLevel===importance)&&(!from||new Date(a.publishedAt)>=new Date(from)));$('#article-table').innerHTML=articleTable(filtered)}
      async function runConfirm(){const yes=await confirmDialog('Start news automation?','This starts a GitHub Actions run now. It may use your Gemini API quota. The run will follow the saved AI settings.','Run automation');if(!yes)return;try{await post('/automation/run',{confirm:true});toast('Automation started. Results will appear here when GitHub updates.');activePage='automation';pageHeader();await render();startPolling()}catch(e){toast(e.message,true)}}
      async function automationPage(){const data=await api('/automation');const s=data.summary||{};const run=data.runs?.[0];return `<div class="grid metrics">${metric('Stories discovered',s.storiesDiscovered)}${metric('Generated',s.articlesGenerated)}${metric('Published',s.articlesPublished)}${metric('Rejected',s.articlesRejected)}${metric('Errors',s.errors?.length||0)}</div><section class="panel"><div class="panel-head"><div><h2>Pipeline status</h2><div class="muted">${run?`Latest GitHub run · ${date(run.createdAt)}`:'No automation run has been recorded yet.'}</div></div><button class="button" id="run-now">▶ &nbsp;Run automation now</button></div>${run?`<div class="runrow"><div class="statusline">${badge(run.conclusion||run.status)}<span>${esc(run.name)} · run #${esc(run.runNumber)}</span></div><a class="link" href="${esc(run.url)}" target="_blank" rel="noreferrer">Open GitHub run ↗</a></div>`:empty('Ready for the first run','Use the button to launch the workflow, or wait for the daily schedule.')}${s.startedAt?`<div class="runrow"><div><strong>Last summary</strong><div class="muted">Started ${date(s.startedAt)} · completed ${date(s.completedAt)}</div></div>${badge(s.status)}</div>`:''}</section><section class="panel"><h2>Latest run details</h2>${s.errors?.length?`<ul>${s.errors.map(error=>`<li class="muted">${esc(error)}</li>`).join('')}</ul>`:empty('No recent pipeline errors','The latest saved automation summary will be shown here.')}</section><section class="panel"><h2>Feed results</h2>${(data.sources||[]).length?data.sources.map(x=>`<div class="feedrow"><div><strong>${esc(x.name)}</strong><div class="muted">${Number(x.storiesFound)||0} stories · fetched ${date(x.lastSuccessfulFetch)}</div>${x.errorInformation?`<div class="muted">${esc(x.errorInformation)}</div>`:''}</div>${badge(x.errorInformation?'Error':x.enabled?'Healthy':'Disabled')}</div>`).join(''):empty('No feed runs yet','Feed-level fetch history appears after automation runs.')}</section>`}
      function sourceTable(){if(!sources.length)return empty('No feeds configured','Add a trusted RSS feed to enable discovery.');return `<div class="table-wrap"><table><thead><tr><th>Name</th><th>Feed URL</th><th>Category</th><th>Reliability</th><th>Enabled</th><th>Last successful fetch</th><th>Feed status</th><th>Actions</th></tr></thead><tbody>${sources.map(s=>`<tr><td class="title">${esc(s.name)}</td><td><a class="link" target="_blank" rel="noreferrer" href="${esc(s.feedUrl)}">Open feed ↗</a></td><td>${esc(s.category)}</td><td>${esc(s.reliability)}</td><td>${s.enabled?'Yes':'No'}</td><td>${date(s.lastSuccessfulFetch)}</td><td>${s.errorInformation?`<span class="pill red" title="${esc(s.errorInformation)}">Fetch error</span>`:'—'}</td><td><div class="actions"><button class="button secondary small" data-source-edit="${esc(s.name)}">Edit</button><button class="button secondary small" data-source-toggle="${esc(s.name)}">${s.enabled?'Disable':'Enable'}</button><button class="button secondary small" data-source-delete="${esc(s.name)}">Delete</button></div></td></tr>`).join('')}</tbody></table></div>`}
      async function sourcesPage(){sources=await api('/sources');return `<section class="panel"><div class="panel-head"><div><h2>Configured discovery feeds</h2><div class="muted">${sources.length} feeds · RSS is used to discover stories, not republish feed text.</div></div><button class="button" id="add-source">＋ Add source</button></div>${sourceTable()}</section>`}
      async function aiSettingsPage(){settings=await api('/settings');return `<form id="settings-form"><section class="panel"><h2>Generation</h2><div class="form-grid"><div class="form-field"><label for="model">Gemini model identifier</label><input class="field" name="model" id="model" value="${esc(settings.model)}" required pattern="gemini-[A-Za-z0-9.-]{1,80}"><small>Uses your GitHub Actions Gemini secret. The model name is not a secret.</small></div><div class="form-field"><label for="max-candidates">Maximum candidates per run</label><input class="field" id="max-candidates" name="maximumCandidatesPerRun" type="number" min="1" max="50" value="${settings.maximumCandidatesPerRun}"></div><div class="form-field"><label for="importance">Minimum importance to publish automatically</label><select id="importance" name="minimumImportanceScore">${[1,2,3,4,5].map(n=>`<option value="${n}" ${n===settings.minimumImportanceScore?'selected':''}>${n} / 5</option>`).join('')}</select></div><div class="form-field"><label>Categories enabled</label><div class="checkcats">${categories.map(c=>`<label class="checkline"><input type="checkbox" name="category" value="${esc(c)}" ${settings.enabledCategories.includes(c)?'checked':''}>${esc(c)}</label>`).join('')}</div></div></div></section><section class="panel"><h2>Research and quality rules</h2><div class="form-grid"><div class="form-field"><label>Minimum independent sources</label><input class="field" type="number" min="2" max="8" name="minimumSources" value="${settings.researchRequirements.minimumSources}"></div><div class="form-field"><label>Minimum article words</label><input class="field" type="number" min="250" max="1000" name="minimumWords" value="${settings.qualityThresholds.minimumWords}"></div><div class="form-field"><label>Maximum article words</label><input class="field" type="number" min="500" max="1500" name="maximumWords" value="${settings.qualityThresholds.maximumWords}"></div><div class="form-field"><label>Automatic publication</label><label class="checkline"><input name="automaticPublishingEnabled" type="checkbox" ${settings.automaticPublishingEnabled?'checked':''}>Publish eligible lower-impact stories automatically</label></div></div><div class="bar"></div><strong>Required safeguards</strong><div class="muted">Source validation, duplicate detection, and primary-source checks are always on.</div><label class="checkline"><input type="checkbox" checked disabled>High-impact stories (score 4+) require manual review</label><label class="checkline"><input type="checkbox" checked disabled>Sensitive stories require manual review</label><label class="checkline"><input type="checkbox" checked disabled>Conflicting reports require manual review</label><div style="margin-top:14px"><button class="button" type="submit">Save AI settings</button></div></section></form>`}
      async function logsPage(){const data=await api('/logs');return `<section class="panel"><div class="panel-head"><h2>Recent automation runs</h2><span class="muted">From GitHub Actions</span></div>${data.runs?.length?data.runs.map(run=>`<div class="runrow"><div><div class="statusline">${badge(run.conclusion||run.status)}<strong>${esc(run.name)} · #${esc(run.runNumber)}</strong></div><div class="muted">${date(run.createdAt)}</div></div><a class="link" href="${esc(run.url)}" target="_blank" rel="noreferrer">View details ↗</a></div>`).join(''):empty('No workflow runs','Run history appears after the first scheduled or manual run.')}</section><section class="panel"><h2>Latest automation window</h2>${data.summary?.startedAt?`<div class="runrow"><span>Started ${date(data.summary.startedAt)}</span><span>Completed ${date(data.summary.completedAt)}</span></div>`:empty("No completed run summary","Run start and finish times are saved by the workflow.")}</section><section class="panel"><h2>Website deployment checks</h2>${(data.deployments||[]).length?data.deployments.map(status=>`<div class="runrow"><div><strong>${esc(status.context)}</strong><div class="muted">${esc(status.description)} · ${date(status.updatedAt)}</div></div>${status.url?`<a class="link" href="${esc(status.url)}" target="_blank" rel="noreferrer">View ↗</a>`:badge(status.state)}</div>`).join(''):empty('No deployment check reported','GitHub has not reported a deployment status for the latest article commit.')}</section><section class="panel"><h2>Latest feed and pipeline messages</h2>${(data.summary?.errors||[]).length?`<ul>${data.summary.errors.map(error=>`<li class="muted">${esc(error)}</li>`).join('')}</ul>`:empty('No saved errors','Errors from the latest run will be listed here.')}${(data.sources||[]).filter(x=>x.errorInformation).map(x=>`<div class="feedrow"><div><strong>${esc(x.name)}</strong><div class="muted">${esc(x.errorInformation)}</div></div>${badge('Feed error')}</div>`).join('')}</section>`}
      async function settingsPage(){const data=await api('/settings/security');return `<section class="panel"><h2>Signed-in owner</h2><div class="runrow"><div><strong>${esc(data.accessEmail)}</strong><div class="muted">Identity verified by Cloudflare Access on each API request.</div></div>${badge('Verified')}</div></section><section class="panel"><h2>GitHub connection</h2><div class="runrow"><div><strong>${esc(data.repository)}</strong><div class="muted">Default branch: ${esc(data.branch)}</div></div><a class="link" href="https://github.com/${encodeURIComponent(data.repository).replace('%2F','/')}/actions" target="_blank" rel="noreferrer">Open Actions ↗</a></div><div class="muted">GitHub credentials are stored as Worker secrets. Gemini credentials stay in GitHub Actions secrets and are never sent to this browser.</div></section><section class="panel"><h2>Cloudflare Access</h2><div class="muted">This area is protected by Cloudflare Access. If you need to change who can sign in, edit the Access policies in your Cloudflare Zero Trust dashboard.</div></section>`}
      async function render(){pageHeader();view.innerHTML='<div class="loading">Loading secure dashboard data…</div>';try{const renderers={overview,articles:articlePage,automation:automationPage,sources:sourcesPage,'ai-settings':aiSettingsPage,logs:logsPage,settings:settingsPage};view.innerHTML=await renderers[activePage]()}catch(error){view.innerHTML=`<section class="panel">${empty('Dashboard data could not be loaded',error.message)}<div style="text-align:center"><button class="button secondary" id="retry">Try again</button></div></section>`}}
      async function confirmDialog(title,message,confirm='Confirm'){return new Promise(resolve=>{const d=$('#confirm-modal');$('#confirm-title').textContent=title;$('#confirm-body').textContent=message;$('#confirm-action').textContent=confirm;pendingConfirm=resolve;d.showModal()})}
      function finishConfirm(value){const d=$('#confirm-modal');if(d.open)d.close();if(pendingConfirm){pendingConfirm(value);pendingConfirm=null}}
      async function editArticle(slug){try{const {article:a}=await api(`/articles/${encodeURIComponent(slug)}`);currentEditorSlug=slug;$('#editor-title').textContent=`Edit · ${a.title}`;const frontmatter={...a};delete frontmatter.id;delete frontmatter.content;$('#editor-body').innerHTML=`<form id="article-form"><div class="form-grid"><div class="form-field full"><label>Title</label><input class="field" name="title" value="${esc(a.title)}" required minlength="8" maxlength="140"></div><div class="form-field full"><label>Introduction</label><textarea name="introduction" minlength="40" maxlength="300" required>${esc(a.introduction)}</textarea></div><div class="form-field"><label>Category</label><select name="category">${categories.map(c=>`<option ${a.category===c?'selected':''}>${esc(c)}</option>`).join('')}</select></div><div class="form-field"><label>Tags (comma separated)</label><input class="field" name="tags" value="${esc((a.tags||[]).join(', '))}"></div><div class="form-field"><label>Event date</label><input class="field" name="eventAt" type="datetime-local" value="${new Date(a.eventAt).toISOString().slice(0,16)}"></div><div class="form-field"><label>Publication date</label><input class="field" value="${esc(date(a.publishedAt))}" disabled></div><div class="form-field"><label>Current importance score</label><input class="field" value="${a.importanceScore} / 5" disabled><small>Calculated from the saved importance factors.</small></div><div class="form-field"><label>Importance reason</label><input class="field" name="importanceReason" value="${esc(a.importanceReason)}" required minlength="12" maxlength="300"></div><div class="form-field full"><label>Sources (JSON array)</label><textarea name="sources" required>${esc(JSON.stringify(a.sources,null,2))}</textarea><small>Each source needs a name, valid URL, and reliability label.</small></div><div class="form-field full"><label>Markdown article</label><textarea class="markdown" name="content" required>${esc(a.content)}</textarea></div></div><input type="hidden" name="slug" value="${esc(a.slug)}"><input type="hidden" name="status" value="${esc(a.status)}"><input type="hidden" name="importanceLevel" value="${esc(a.importanceLevel)}"><input type="hidden" name="importanceFactors" value="${esc(JSON.stringify(a.importanceFactors))}"><input type="hidden" name="isFeatured" value="${a.isFeatured}"><input type="hidden" name="tags-data"></form>`;$('#editor').showModal()}catch(e){toast(e.message,true)}}
      async function viewArticle(slug){try{const {article:a}=await api(`/articles/${encodeURIComponent(slug)}`);currentEditorSlug=null;$('#editor-title').textContent=a.title;$('#editor-body').innerHTML=`<div class="muted">${esc(a.category)} · ${date(a.publishedAt)} · ${esc(a.importanceLevel)} (${a.importanceScore}/5) · ${esc(a.status)}</div><p>${esc(a.introduction)}</p><pre style="white-space:pre-wrap;line-height:1.65;font:14px/1.65 ui-monospace,monospace;background:#f6f8f7;border-radius:9px;padding:16px">${esc(a.content)}</pre><h3>Sources</h3>${a.sources.map(source=>`<p><a class="link" href="${esc(source.url)}" target="_blank" rel="noreferrer">${esc(source.name)} ↗</a></p>`).join('')}`;$('#save-article').hidden=true;$('#editor').showModal()}catch(e){toast(e.message,true)}}
      function newSource(){currentSourceName=null;$('#source-title').textContent='Add news source';$('#source-name').value='';$('#source-url').value='';$('#source-category').selectedIndex=0;$('#source-reliability').value='primary';$('#source-enabled').checked=true;$('#feed-validation').textContent='';$('#source-modal').showModal()}
      function editSource(name){const s=sources.find(x=>x.name===name);if(!s)return;currentSourceName=name;$('#source-title').textContent='Edit news source';$('#source-name').value=s.name;$('#source-url').value=s.feedUrl;$('#source-category').value=s.category;$('#source-reliability').value=s.reliability;$('#source-enabled').checked=s.enabled;$('#feed-validation').textContent='';$('#source-modal').showModal()}
      async function saveSources(next){await put('/sources',{sources:next});sources=await api('/sources');view.innerHTML=`<section class="panel"><div class="panel-head"><div><h2>Configured discovery feeds</h2><div class="muted">${sources.length} feeds · RSS is used to discover stories, not republish feed text.</div></div><button class="button" id="add-source">＋ Add source</button></div>${sourceTable()}</section>`}
      function startPolling(){clearInterval(automationTimer);automationTimer=setInterval(async()=>{if(activePage!=='automation'){clearInterval(automationTimer);return}try{await render()}catch{}},15000)}
      document.addEventListener('click',async event=>{const button=event.target.closest('button');if(!button)return;try{if(button.dataset.page){activePage=button.dataset.page;location.hash=activePage;await render()}else if(button.dataset.go){activePage=button.dataset.go;location.hash=activePage;await render()}else if(button.id==='refresh'||button.id==='retry'){await render();toast('Dashboard refreshed.')}else if(button.id==='run-now'||button.id==='run-shortcut')await runConfirm();else if(button.id==='add-source')newSource();else if(button.dataset.view){$('#save-article').hidden=true;await viewArticle(button.dataset.view)}else if(button.dataset.edit){$('#save-article').hidden=false;await editArticle(button.dataset.edit)}else if(button.dataset.approve){const ok=await confirmDialog('Publish this article?','It will become publicly visible after the site deployment completes.','Approve & publish');if(ok){await post(`/articles/${button.dataset.approve}/approve`,{});toast('Article approved.');await render()}}else if(button.dataset.reject){const ok=await confirmDialog('Reject this article?','The article will remain in the archive as rejected and will not appear publicly.','Reject article');if(ok){await post(`/articles/${button.dataset.reject}/reject`,{});toast('Article rejected.');await render()}}else if(button.dataset.delete){const article=articles.find(x=>x.slug===button.dataset.delete);const ok=await confirmDialog('Delete this article?','This permanently removes the Markdown file from the repository. This action cannot be undone.','Delete article');if(ok){await api(`/articles/${button.dataset.delete}`,{method:'DELETE',body:JSON.stringify({confirmTitle:article?.title})});toast('Article deleted.');await render()}}else if(button.dataset.sourceEdit)editSource(button.dataset.sourceEdit);else if(button.dataset.sourceToggle){const next=sources.map(s=>s.name===button.dataset.sourceToggle?{...s,enabled:!s.enabled}:s);await saveSources(next);toast('Source status saved.')}else if(button.dataset.sourceDelete){const ok=await confirmDialog('Delete this feed?','It will be removed from future automation runs.','Delete feed');if(ok){await saveSources(sources.filter(s=>s.name!==button.dataset.sourceDelete));toast('Feed removed.')}}else if(button.hasAttribute('data-close')){button.closest('dialog').close();if(button.closest('dialog').id==='confirm-modal')finishConfirm(false)}}catch(e){toast(e.message,true)}});
      document.addEventListener('input',event=>{if(event.target.matches('#article-search,#filter-date'))renderArticleFilters()});
      document.addEventListener('change',event=>{if(event.target.matches('#filter-status,#filter-category,#filter-importance'))renderArticleFilters()});
      $('#confirm-action').addEventListener('click',()=>finishConfirm(true));
      $('#save-article').addEventListener('click',async()=>{const form=$('#article-form');if(!form?.reportValidity())return;try{const d=new FormData(form), old=JSON.parse(d.get('importanceFactors')), sources=JSON.parse(d.get('sources'));const reliabilityScores={primary:5,'peer-reviewed':5,'reputable-secondary':3,other:1};old.sourceReliability=Math.round(sources.reduce((sum,s)=>sum+(reliabilityScores[s.reliability]||1),0)/sources.length);const vals=Object.values(old);const importanceScore=Math.round(vals.reduce((a,b)=>a+b,0)/vals.length);const level=importanceScore===5?'CRITICAL':importanceScore===4?'HIGH':importanceScore===3?'MEDIUM':'LOW';const original=articles.find(a=>a.slug===currentEditorSlug);const metadata={slug:d.get('slug'),title:d.get('title'),introduction:d.get('introduction'),category:d.get('category'),tags:String(d.get('tags')).split(',').map(s=>s.trim()).filter(Boolean),eventAt:new Date(d.get('eventAt')).toISOString(),publishedAt:original.publishedAt,updatedAt:new Date().toISOString(),importanceScore,importanceLevel:level,importanceFactors:old,importanceReason:d.get('importanceReason'),sources,status:d.get('status'),isFeatured:d.get('isFeatured')==='true'};await put(`/articles/${currentEditorSlug}`,{frontmatter:metadata,content:d.get('content')});$('#editor').close();toast('Article saved.');await render()}catch(e){toast(e.message||'Check source JSON and article metadata.',true)}});
      $('#validate-feed').addEventListener('click',async()=>{try{$('#feed-validation').textContent='Checking feed…';const result=await post('/sources/validate',{url:$('#source-url').value});$('#feed-validation').textContent=`✓ ${result.message} Final URL: ${result.finalUrl}`}catch(e){$('#feed-validation').textContent=`Could not validate feed: ${e.message}`}});
      $('#save-source').addEventListener('click',async()=>{const name=$('#source-name').value.trim(),feedUrl=$('#source-url').value.trim();if(!name||!feedUrl){toast('Enter a source name and feed URL.',true);return}try{new URL(feedUrl);const next=sources.filter(s=>s.name!==currentSourceName);next.push({name,feedUrl,category:$('#source-category').value,reliability:$('#source-reliability').value,enabled:$('#source-enabled').checked});await saveSources(next);$('#source-modal').close();toast('News source saved.')}catch(e){toast(e.message,true)}});
      document.addEventListener('submit',async event=>{if(event.target.id==='settings-form'){event.preventDefault();const f=new FormData(event.target),enabledCategories=[...event.target.querySelectorAll('[name="category"]:checked')].map(x=>x.value);const payload={model:f.get('model'),maximumCandidatesPerRun:Number(f.get('maximumCandidatesPerRun')),minimumImportanceScore:Number(f.get('minimumImportanceScore')),enabledCategories,researchRequirements:{minimumSources:Number(f.get('minimumSources')),requirePrimarySource:true},qualityThresholds:{minimumWords:Number(f.get('minimumWords')),maximumWords:Number(f.get('maximumWords'))},automaticPublishingEnabled:f.has('automaticPublishingEnabled'),manualReview:{highImpactScore:4,sensitiveTopics:true,conflictingReports:true}};try{await put('/settings',payload);toast('AI settings saved. The next run will use them.')}catch(e){toast(e.message,true)}}});
      window.addEventListener('hashchange',()=>{const page=location.hash.slice(1);if(titleMap[page]){activePage=page;render()}});
      if(location.hash.slice(1) in titleMap)activePage=location.hash.slice(1);render();
    </script>
  </body>
</html>
